{
  "subscriber": {
    "host": "127.0.0.1",
    "port": 9000
  },
  "gui_reply_port":       9005,
  "gui_video_reply_port": 9006,
  "gui_ai_reply_port":    9007,
  "cloud": {
    "endpoint": "http://localhost:8080/api/events",
    "api_key": "",
    "max_retries": 3,
    "timeout_sec": 10,
    "enabled": true
  },
  "log": {
    "path": "/var/log/aeroboard/eventhub.log"
  },
  "gpio_map": {
    "gpio0":      288,
    "gpio1":      289,
    "pwm_enable": 290,
    "spi_bus":    291
  },
  "workers": {
    "video": {
      "enabled": true,
      "pub_port": 9001,
      "settings_port": 9010,
      "config": "/etc/aeroboard/video.json",
      "binary": "/usr/bin/aeroboard-video"
    },
    "sensor": {
      "enabled": false,
      "pub_port": 9002,
      "settings_port": 0,
      "config": "/etc/aeroboard/sensor.json",
      "binary": "/usr/bin/aeroboard-sensor"
    },
    "system": {
      "enabled": true,
      "pub_port": 9003,
      "settings_port": 0,
      "config": "/etc/aeroboard/system.json",
      "binary": "/usr/bin/aeroboard-system"
    },
    "ai": {
      "enabled": true,
      "pub_port": 9004,
      "settings_port": 9011,
      "config": "/etc/aeroboard/ai.json",
      "binary": "/usr/bin/aeroboard-ai"
    }
  }
}